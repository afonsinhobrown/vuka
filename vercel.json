{
  "services": {
    "admin-web": {
      "root": "apps/admin-web"
    },
    "reader-app": {
      "root": "apps/reader-app"
    },
    "api": {
      "root": "apps/api",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin/assets/(.*)",
      "destination": {
        "service": "admin-web"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin-web"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin-web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "reader-app"
      }
    }
  ]
}
