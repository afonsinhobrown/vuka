{
  "services": {
    "api": {
      "root": "apps/api",
      "entrypoint": "src/server.ts"
    },
    "admin-web": {
      "root": "apps/admin-web",
      "rewrites": [
        {
          "source": "/admin/assets/(.*)",
          "destination": "/assets/$1"
        },
        {
          "source": "/admin",
          "destination": "/index.html"
        },
        {
          "source": "/admin/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "publisher-web": {
      "root": "apps/publisher-web",
      "rewrites": [
        {
          "source": "/editora/assets/(.*)",
          "destination": "/assets/$1"
        },
        {
          "source": "/editora",
          "destination": "/index.html"
        },
        {
          "source": "/editora/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "reader-app": {
      "root": "apps/reader-app",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin-web"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin-web"
      }
    },
    {
      "source": "/editora",
      "destination": {
        "service": "publisher-web"
      }
    },
    {
      "source": "/editora/(.*)",
      "destination": {
        "service": "publisher-web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "reader-app"
      }
    }
  ]
}
