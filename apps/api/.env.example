# VUKA Environment Variables Example
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-curly-sky-ba7y9vgs-pooler.c-8.eu-central-1.aws.neon.tech/vuka?sslmode=require"
PORT=4000
NODE_ENV="development"
JWT_SECRET="vuka_super_secure_jwt_token_key_2026_mozambique"
CONTENT_SIGNING_SECRET="vuka_content_hmac_signing_key_very_secret_998811"
STORAGE_DIR="./storage"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="vuka_whatsapp_webhook_token_2026"
BASE_URL="http://localhost:4000"
READER_APP_URL="http://localhost:5173"
ADMIN_APP_URL="http://localhost:5174"

# PaySuite Gateway (M-Pesa, E-Mola, Cartões)
PAYSUITE_API_URL="https://paysuite.tech/api/v1"
PAYSUITE_API_TOKEN=""
PAYSUITE_WEBHOOK_SECRET=""
# URL pública da API (é usada no webhook_url enviado à PaySuite)
BASE_URL="http://localhost:4000"
# Modo sandbox: a PaySuite cobra um valor FIXO (10 MT) independentemente do
# preço do jornal. Com true, esse valor exacto é aceite no webhook.
# Em PRODUÇÃO tem de ficar false (mantém a validação de valor RB-02).
PAYSUITE_SANDBOX="true"
# Valor fixo do sandbox em minor units (1000 = 10,00 MZN). Ajustar se a conta
# de testes da PaySuite usar outro valor.
PAYSUITE_SANDBOX_AMOUNT_MINOR_UNITS="1000"

# Object Storage (Cloudflare R2) — OBRIGATÓRIO em produção (Vercel)
# Sem estas variáveis o upload de PDFs usa disco local (só funciona em dev).
# Na Vercel: Settings → Environment Variables (Production e Preview).
OBJECT_STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
OBJECT_STORAGE_BUCKET="vuka-editions"
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
# Prefixo das chaves dentro do bucket (permite partilhar o bucket com outras apps)
OBJECT_STORAGE_PREFIX="vuka"
